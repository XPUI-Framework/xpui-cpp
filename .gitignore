.DS_Store

# Generated by Cargo
target/
**/*.rs.bk

# Cargo.lock is deliberately NOT ignored. A committed lock file is what makes
# a clone reproduce the build that was proved here, and it is what
# `xpui-dev`'s `locks_agree` reads to check that the crates whose types cross
# a repository boundary are the same version in every one.

# PlatformIO's build directory, and the sdkconfig it generates per board.
# `firmware/platformio.ini` is the input; everything below is output.
.pio/
firmware/sdkconfig.*
# PlatformIO writes this for espidf projects if it is missing, so it is output
# rather than input.
firmware/CMakeLists.txt
firmware/cpp/CMakeLists.txt
